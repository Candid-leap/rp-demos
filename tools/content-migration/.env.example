# Copy to .env and fill in. The CLI reads this file from content-migration/.env
# Webflow Data API token with assets:write + assets:read scopes
WEBFLOW_API_TOKEN=
# The Webflow site id (Site settings -> General -> Site ID)
WEBFLOW_SITE_ID=
# Optional: asset folder id to upload into (leave empty for root asset library)
WEBFLOW_ASSET_FOLDER_ID=
# Legacy-CMS CDN domain + portal id that /hubfs files are fetched from.
# Read these off the absolute CDN URLs in your own content export, then confirm
# that https://<CDN_DOMAIN>/hubfs/<PORTAL_ID>/<path> actually resolves.
HUBSPOT_CDN_DOMAIN=
HUBSPOT_PORTAL_ID=
# Base URL used to verify relative rewritten links
SITE_BASE_URL=https://www.example.com
# Portal port
PORTAL_PORT=4321
