{
  // Local development only — routes are managed by Terraform, not Wrangler.
  "name": "proxy-dual-origin",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-01",
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "ALLOWED_HOSTS": "www.example.com,example.com,www.example.net,example.net",
    "WEBFLOW_ORIGIN": "https://webflow1.example.com",
    "HUBSPOT_ORIGIN": "https://hs.example.com"
  }
}
