{
  "name": "proxy-dual-origin",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker reverse proxy: two fixed origins (legacy CMS + new CMS), Terraform-managed",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "eslint": "^9.16.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.95.0"
  }
}
